# Browser-facing URLs (local defaults)
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_AI_BASE_URL=http://localhost:8001/v1

# API service
API_PORT=4000
DATABASE_URL=postgresql://platform:platform@localhost:5432/platform
JWT_SECRET=replace-with-a-long-random-secret

# AI service; leave blank for the local mock response
AI_PORT=8001
OPENAI_API_KEY=
OPENAI_MODEL=

# Set these when connecting production domains
PUBLIC_SITE_URL=https://www.example.com
LEARN_SITE_URL=https://learn.example.com
ADMIN_SITE_URL=https://admin.example.com
API_PUBLIC_URL=https://api.example.com
AI_PUBLIC_URL=https://ai.example.com
